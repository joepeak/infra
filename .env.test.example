# infra 集成测试配置（示范文件）
# 复制为 .env.test 并填入真实值——.env.test 已被 .gitignore 排除
#
# 使用：pytest -m integration tests/test_redis_integration.py
# 默认 pytest tests/ 会 skip（无 REDIS_INTEGRATION_HOST）

# 真 redis 地址
REDIS_INTEGRATION_HOST=127.0.0.1

# 端口（默认 6379）
REDIS_INTEGRATION_PORT=6379

# db 编号（默认 0）
REDIS_INTEGRATION_DB=0

# 密码（无密码时留空）
REDIS_INTEGRATION_PASSWORD=
